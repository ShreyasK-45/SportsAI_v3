# Copy this file to .env.local and fill in your Supabase project values.
# Find them at: https://supabase.com → your project → Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON=YOUR_ANON_KEY

# Optional. Setting this enables video upload to the Python backend at this URL.
# Leave unset to keep video processing in the browser only.
# VITE_BACKEND_URL=http://localhost:8000
